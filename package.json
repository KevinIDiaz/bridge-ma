{
  "name": "bridge-ma",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge MA: sourced next steps across SNAP, RAFT, and utility protection (fictional demo)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:property": "vitest run tests/property",
    "test:e2e": "playwright test",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:provenance": "node scripts/validate-provenance.mjs",
    "build": "next build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
